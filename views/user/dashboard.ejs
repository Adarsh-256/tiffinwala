<%- layout('/layouts/boilerplate') %>

<div class="new-container" style="margin-top: 60px; background-color:rgb(158, 147, 142) ;">
  <div class="row">

    <!-- Sidebar -->
    <div class="col-md-2 bg-secondary vh-40 p-3">
      <div class="list-group">
        <a href="#main-content" class="list-group-item list-group-item-action active">
          <i class="fa-solid fa-house"></i>
          Browse Tiffins
        </a>
        <a href="#current-orders" class="list-group-item list-group-item-action">
          <i class="fa-solid fa-cart-shopping"></i>
          Current Orders
        </a>
        <a href="#order-history" class="list-group-item list-group-item-action">
          <i class="fa-solid fa-clock-rotate-left"></i>
          Order History
        </a>
        <a href="#profile" class="list-group-item list-group-item-action">
          <i class="fa-solid fa-user"></i>
          My Profile
        </a>
      </div>
    </div>


    <!-- Main Content -->
    <div id="main-content" class="col-md-10 p-4 ">
      <h2 class="fw-bold">
        Browse Tiffin Providers
      </h2>
      <p class="text-muted">
        Find the perfect homemade meal
      </p>

    
   
      <!-- Cards -->
   <div id="menu" class=" container bg-light col-md-13 p-4 ">
  <div>
    <h3 class="fw-bold">Today's Menu</h3>
    <p class="text-muted">Check out our delicious offerings for today</p>
  </div>
   <div class="row g-4">

  <% for(let menu of allMenu){ %>

    <div class="col-lg-4 col-md-6 col-sm-12">

      <div class="card h-100 shadow">

        <a href="/provider/menu/<%= menu._id %>" class="text-decoration-none text-dark">

          <img src="<%= menu.image.url %>"
               class="card-img-top"
               alt="menu_image"
               style="height:220px; object-fit:cover;">

          <div class="card-body d-flex flex-column">

            <h5 class="card-title fw-bold">
              <%= menu.title %>
            </h5>

            <h4 class="text-danger fw-bold mb-3">
              ₹ <%= menu.price.toLocaleString('en-IN') %>
              <small class="text-muted">+18% GST</small> 
            </h4>
            <p class="card-text text-muted mb-3">
              <%= menu.description %>
            </p>
            <div class=" d-flex justify-content-around align-items-center gap-2">
              <a href="/provider/menu/<%= menu._id %>" class="btn btn-warning w-100">
                Order Now 
            </a>
            </div>
          </div>
        </a>
      </div>
    </div>
  <% } %>
</div>
 </div>
      

    <!-- current orders -->
<div id="current-orders" class="container bg-light col-md-13 p-4">
    <div>
        <h2>Current Orders</h2>
        <p>Track your ongoing orders and their status</p>
    </div>
       <% const currentOrders = orders.filter(order =>
        order.status === "Pending" ||
        order.status === "Accepted"
    ); %>
    <% if (currentOrders.length === 0) { %>
        <div class="alert alert-info">
            No current orders.
        </div>
    <% } %>
    <% currentOrders.forEach(order => { %>
        <div class="d-flex justify-content-between align-items-center p-4 border rounded shadow-sm mb-3">
            <div>
                <h5>
                    Order #<%= order._id.toString().slice(-6) %>
                </h5>
              
                <p>
                    Quantity: <%= order.quantity %>
                </p>
            </div>
            <div class="text-end">
                <h2 class="text-danger">
                    ₹ <%= order.totalPrice %>
                </h2>
                <p>
                    Ordered:
                    <%= order.createdAt.toLocaleDateString() %>
                </p>
                <p>
                  Provider: <%= order.provider.username %>
                </p>
            </div>
             <div>
                    <% if (order.status === "Pending") { %>
                        <span class="badge bg-warning">
                            Waiting for Provider
                        </span>
                    <% } %>
                    <% if (order.status === "Accepted") { %>
                        <span class="badge bg-success">
                            Accepted
                        </span>
                    <% } %>
                </div>
        </div>
    <% }) %>
</div>

  <!-- Order History -->
    
 <div id="order-history" class="container bg-light col-md-13 p-4">
    <div>
        <h2>Order History</h2>
        <p>Check your past orders and their status</p>
    </div>
    <% const pastOrders = orders.filter(order =>
        ["Delivered", "Cancelled"].includes(order.status)
    ); %>
    <% if (pastOrders.length === 0) { %>
        <div class="alert alert-info">
            No order history yet.
        </div>
    <% } %>
    <% pastOrders.forEach(order => { %>
        <div class="d-flex justify-content-between align-items-center p-4 border rounded shadow-sm mb-3">
            <div>
                <h5>
                    Order #<%= order._id.toString().slice(-6) %>
                </h5>
               
                <p>
                    Quantity: <%= order.quantity %>
                </p>
                <p>
                    Status: <%= order.status %>
                </p>
                <p>
                    Ordered:
                    <%= order.createdAt.toLocaleDateString() %>
                </p>
            </div>
            <div class="text-end">
                <h2 class="text-danger">
                    ₹ <%= order.totalPrice %>
                </h2>
                <% if (order.status === "Delivered") { %>
                    <button class="btn btn-secondary">
                        Rate & Review
                    </button>
                <% } %>
            </div>
        </div>
    <% }) %>
</div>

<!-- customer profile -->
<div id="profile" class="container bg-light col-md-13 p-4">
  <div>
    
    <h2>My  Profile</h2>
    <p>Manage your personal information and preferences</p>
  </div>
  <div class="  p-4  border rounded shadow-sm mb-3">
    <div>
<% if(owner.role === "customer") { %>
      <h5>Name: <%= owner.username %></h5>
      <h6>Email: <%= owner.email %></h6>
      <h6>Phone: <%= owner.phone ? owner.phone : "Not provided" %></h6>
      <h6>Address: <%= owner.address ? owner.address : "Not provided" %></h6>
<% } %>
    </div>

  </div>
  </div>
  </div>

  </div>
</div>