<%- layout('/layouts/boilerplate') %>

<div class="new-container" style="margin-top: 60px;">
<div class="row justify-content-center ">

<div class="col-lg-7 mt-5 mb-5">

<div class="card shadow-lg border-0 rounded-4">

<div class="card-header bg-success text-white text-center">
<h3>Secure Payment</h3>
</div>

<div class="card-body">

<h4><%= menu.title %></h4>
<h5 class="text-success mb-4">Total: ₹ 
    <spam id="totalPrice"> <%= totalPrice %></spam>
    </h5>

<form action="/provider/menu/<%= menu._id %>/order/confirm" method="POST">

<div class="mb-3">

<div class="form-check">
<input class="form-check-input"
type="radio"
name="paymentMethod"
value="COD"
checked
onclick="changePayment('cod')">

<label class="form-check-label">
Cash on Delivery
</label>
</div>

<div class="form-check">
<input class="form-check-input"
type="radio"
name="paymentMethod"
value="UPI"
onclick="changePayment('upi')">

<label class="form-check-label">
UPI Payment
</label>
</div>

<div class="form-check">
<input class="form-check-input"
type="radio"
name="paymentMethod"
value="CARD"
onclick="changePayment('card')">

<label class="form-check-label">
Debit / Credit Card
</label>
</div>

</div>


<!-- COD -->

<div id="cod">

<div class="alert alert-success">
Pay after receiving your meal.
</div>
<button class="btn btn-success w-100 mt-4">
Place Order
</button>

</div>


<!-- UPI -->

<div id="upi" style="display:none;">

<label class="fw-bold">Select UPI App</label>

<select class="form-select mb-3" name="upiApp">

<option>Google Pay</option>
<option>PhonePe</option>
<option>Paytm</option>
<option>BHIM</option>

</select>

<div class="text-center">

<img
src="https://api.qrserver.com/v1/create-qr-code/?size=220x220&data=upi://pay?pa=adarshk6036-1@okaxis&pn=Adarsh Kumar&am=<%= menu.price %>&cu=INR"
class="img-fluid border rounded shadow">


<p class="mt-3">
UPI ID :
<strong>adarshk6036-1@okaxis</strong>
</p>

</div>
<button class="btn btn-success w-100 mt-4">
Scan & Pay
</button>
</div>


<!-- CARD -->

<div id="card" style="display:none;">

  <div class="mb-3">
    <label class="form-label">Card Number</label>
    <input
      type="text"
      class="form-control"
      placeholder="1234 5678 9012 3456">
  </div>

  <div class="row g-3">

    <div class="col-6">
      <label class="form-label">Expiry</label>
      <input
        type="text"
        class="form-control"
        placeholder="MM/YY">
    </div>

    <div class="col-6">
      <label class="form-label">CVV</label>
      <input
        type="password"
        class="form-control"
        placeholder="123">
    </div>

  </div>

  <button type="submit" class="btn btn-success w-100 mt-4">
    Pay Now
  </button>

</div>
</div>



</form>

</div>

</div>

</div>

</div>
</div>

<script>

function changePayment(type){

document.getElementById("cod").style.display="none";
document.getElementById("upi").style.display="none";
document.getElementById("card").style.display="none";

document.getElementById(type).style.display="block";

}

</script>