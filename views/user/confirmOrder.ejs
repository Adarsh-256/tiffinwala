<%- layout('/layouts/boilerplate') %>

<div class="new-container" style="margin-top: 60px; background-color:rgb(246, 230, 219)">
  <div class="row justify-content-center ">
    <div class="col-lg-7 mt-5 mb-5">

      <div class="card shadow-lg border-0 rounded-4">

        <div class="card-header bg-success text-white text-center">
          <h3>Confirm Your Order</h3>
        </div>

        <div class="card-body">

          <h4><%= menu.title %></h4>
          <h5 class="text-success mb-4"> ₹
            <spam id="totalPrice"> <%= menu.price %></spam>
            </h5>

          <form action="/provider/menu/<%= menu._id %>/order" method="POST">

            <div class="mb-3">
              <label for="quantity" class="form-label">Quantity</label>
              <input type="number"
                     class="form-control"
                     id="quantity"
                     name="quantity"
                     value="1"
                     min="1"
                     required>
            </div>

            <div class="mb-3">
              <label for="address" class="form-label">Delivery Address</label>
              <textarea class="form-control"
                        id="address"
                        name="address"
                        rows="3"
                        required></textarea>
            </div>

            <button type="submit" class="btn btn-success w-100 mt-4">Place Order</button>

          </form>

        </div>

      </div>

    </div>
